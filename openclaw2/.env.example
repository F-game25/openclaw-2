# Environment Variables for OpenClaw AI + AI Employee
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Security - REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# AI API Keys (Optional - only if using external APIs)
# Leave empty if using local models only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Employee - Claude Agent settings
# Required if using the claude-agent bot
# ANTHROPIC_API_KEY is shared above
CLAUDE_MODEL=claude-opus-4-5

# AI Employee - Ollama settings (local LLM, optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# AI Employee - UI ports (optional, change if ports are in use)
PROBLEM_SOLVER_UI_PORT=8787
DASHBOARD_PORT=3000

# Database (Optional - if using external database)
# DATABASE_URL=sqlite:///./data/openclaw.db

# Additional Security (Optional)
# RATE_LIMIT_PER_MINUTE=60
# MAX_SESSIONS_PER_USER=3
