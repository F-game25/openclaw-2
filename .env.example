# Environment Variables for OpenClaw AI - Private & Secure
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Security - REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# AI API Keys (Optional - only if using external APIs)
# Leave empty if using local models only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database (Optional - if using external database)
# DATABASE_URL=sqlite:///./data/openclaw.db

# Additional Security (Optional)
# RATE_LIMIT_PER_MINUTE=60
# MAX_SESSIONS_PER_USER=3
